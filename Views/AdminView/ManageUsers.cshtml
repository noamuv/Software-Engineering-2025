@{
    ViewData["Title"] = "Manage Users";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="container">
    <h1 class="page-title">Manage Users</h1>
    
    <!-- Success Alert -->
    <div id="successAlert" class="alert-success-custom">
        <strong>Success!</strong> <span id="successMessage"></span>
    </div>
    
    <!-- Error Alert -->
    <div id="errorAlert" class="alert-danger-custom">
        <strong>Error!</strong> <span id="errorMessage"></span>
    </div>
    
    <div class="admin-card-wide">
        
        <!-- Loading State -->
        <div id="loadingUsers" class="text-center" style="display: none;">
            <div class="spinner-border-custom" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading users...</p>
        </div>
        
        <!-- No Users State -->
        <div id="noUsers" class="alert-info-custom text-center" style="display: none;">
            <i class="bi bi-info-circle" style="font-size: 2rem;"></i>
            <p class="mb-0 mt-2">No users found. Create your first user to get started!</p>
            <a href="@Url.Action("CreateUser", "AdminView")" class="btn-primary-custom mt-3" style="width: auto; padding: 0.5rem 2rem;">
                Create First User
            </a>
        </div>
        
        <!-- Users Table -->
        <div class="table-responsive">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>User Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <!-- Populated by JavaScript -->
                </tbody>
            </table>
        </div>
        
        <div class="mt-4 text-center">
            <a href="@Url.Action("Index", "AdminView")" class="text-muted">
                ← Back to Dashboard
            </a>
        </div>
        
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script src="~/js/admin.js"></script>