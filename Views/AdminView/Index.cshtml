@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="container">
    <h1 class="page-title">Admin Dashboard</h1>
    
    <div class="admin-card">
        <h3 style="color: var(--primary-purple); margin-bottom: 2rem; text-align: center;">
            Welcome, Administrator
        </h3>
        
        <p class="text-center text-muted mb-4">
            Manage user accounts for the Sensore pressure monitoring system
        </p>
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <a href="@Url.Action("CreateUser", "AdminView")" class="dashboard-card">
                    <i class="bi bi-person-plus-fill"></i>
                    <h4>Create New User</h4>
                    <p class="text-muted mb-0">Add new admin, clinician, patient, or carer accounts</p>
                </a>
            </div>
            <div class="col-md-6 mb-3">
                <a href="@Url.Action("ManageUsers", "AdminView")" class="dashboard-card">
                    <i class="bi bi-people-fill"></i>
                    <h4>Manage Users</h4>
                    <p class="text-muted mb-0">View, enable, or disable user accounts</p>
                </a>
            </div>
        </div>
    </div>
</div>