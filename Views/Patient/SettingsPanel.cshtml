@model Software_Engineering_2025.Models.AppUser

<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/css/patient-settingspanel.css" />
</head>


<div class="panel-header">
    Settings
    <button class="close-btn" onclick="closePanel()">×</button>
</div>

<div class="tabs">
    <button class="tab active" onclick="switchTab('passwordTab', event)">Password</button>
    <button class="tab" onclick="switchTab('careTeamTab', event)">Care Team</button>
</div>

<div class="panel-content">
    <!-- Password Tab -->
    <div id="passwordTab" class="tab-content active">
        <h3>Change Password</h3>
        <form id="changePasswordForm" onsubmit="changePassword(event)">
            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="currentPassword" required>
            </div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" required>
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" required>
            </div>
            <button type="submit" class="btn btn-primary">Update Password</button>
        </form>
    </div>

    <!-- Care Team Tab -->
    <div id="careTeamTab" class="tab-content">
        <h3>Carers</h3>
        <p class="subtitle">Add carers who can view your data</p>
       
        <div class="form-group">
            <label>Carer Email</label>
            <input type="email" id="carerEmail" placeholder="carer@example.com">
        </div>
        <button class="btn btn-primary" onclick="addCarer()">Add Carer</button>
       
        <div id="carersList" style="margin-top: 20px;"></div>

        <hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;">

        <h3>Clinician</h3>
        <p class="subtitle">Add your clinician</p>
       
        <div class="form-group">
            <label>Clinician Email</label>
            <input type="email" id="clinicianEmail" placeholder="clinician@example.com">
        </div>
        <button class="btn btn-primary" onclick="addClinician()">Add Clinician</button>
       
        <div id="cliniciansList" style="margin-top: 20px;"></div>
    </div>
</div>
</html>

<script src="~/js/patient-settingspanel.js"></script>
