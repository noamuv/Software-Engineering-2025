@model Software_Engineering_2025.Models.AppUser


<html>
<head>
    <link rel="stylesheet" href="~/css/patient-settingspanel.css" />
    </head>

<body>
<div class="panel-header">
    Settings
    <button class="close-btn" onclick="closePanel()">×</button>
</div>

<!-- TABS OUTSIDE ANY FORM -->
<div class="tabs">
    <button type="button" class="tab active" onclick="switchSettingsTab('password')">Password</button>
    <button type="button" class="tab active" onclick="switchSettingsTab('careteam')">Care Team</button>
    <button type="button" class="tab active" onclick="switchSettingsTab('documents')">Documents</button>
</div>

<div class="panel-content">
    <!-- ===== PASSWORD TAB ===== -->
    <div id="passwordTab" class="tab-content active">
        <h3>Change Password</h3>
        
        <!-- INDEPENDENT FORM - Only submits when button clicked -->
        <form onsubmit="handlePasswordChange(event); return false;" autocomplete="off">
            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="currentPassword" autocomplete="current-password"
                required>
            </div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" autocomplete="current-password" required>
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" autocomplete="new-password" required>
            </div>
            <button type="submit" class="btn btn-primary">Update Password</button>
        </form>
    </div>

    <!-- ===== CARE TEAM TAB ===== -->
    <div id="careteamTab" class="tab-content active">
        <h3>Add Carer</h3>
        <p class="subtitle">Carers can view your pressure data and monitor your health.</p>
        
        <!-- NO FORM - Just inputs with button onclick -->
        <div class="form-group">
            <label>Carer Email</label>
            <input type="email" id="carerEmail" placeholder="carer@example.com">
        </div>
        <button type="button" class="btn btn-primary" onclick="addCarer()">Add Carer</button>
        
        <div id="carersList"></div>

        <hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;">

        <h3>Add Clinician</h3>
        <p class="subtitle">Your primary healthcare provider.</p>
        
        <div class="form-group">
            <label>Clinician Email</label>
            <input type="email" id="clinicianEmail" placeholder="doctor@hospital.com">
        </div>
        <button type="button" class="btn btn-primary" onclick="addClinician()">Add Clinician</button>
        
        <div id="cliniciansList"></div>
    </div>

    <!-- ===== DOCUMENTS TAB ===== -->
    <div id="documentsTab" class="tab-content active">
        <h3>Health Documents</h3>
        <p class="subtitle">Upload medical records, prescriptions, and test results. (Max 10MB)</p>

        <!-- Upload Zone -->
        <div class="upload-zone" onclick="document.getElementById('fileUploadInput').click()">
            <div class="upload-icon">📄</div>
            <div class="upload-text">Click to upload</div>
            <div class="upload-hint">PDF, JPG, PNG</div>
        </div>
        <input type="file" id="fileUploadInput" style="display: none;" multiple 
               accept=".pdf,.jpg,.jpeg,.png,.docx" onchange="handleFileUpload(event)">

        <!-- File List -->
        <div id="uploadedFilesList" class="file-list">
            <div class="empty-state">📭 No documents uploaded</div>
        </div>
    </div>
</div>

<script src="~/js/patient-settingspanel.js">
</script>
</body>
<html>