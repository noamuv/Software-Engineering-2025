@model Software_Engineering_2025.Models.AppUser

@{
    Layout = null;
     var sessions = ViewBag.AvailableSessions as List<Software_Engineering_2025.Models.PressureSession>;
    var currentSession = ViewBag.CurrentSession as Software_Engineering_2025.Models.PressureSession;
    var metrics = ViewBag.Metrics;
}

<!DOCTYPE html>
<html>
<head>
    <title>Sensore - Patient Dashboard</title>
    <link rel="stylesheet" type="text/css" href="~/css/patient-dashboard.css" />
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-icon" onclick="loadPanel('messages')" id="messagesIcon">💬
        <div class="sidebar-icon-label">Messages</div>
        </div>

        <div class="sidebar-icon" onclick="loadPanel('settings')" id="settingsIcon">⚙️
        <div class="sidebar-icon-label">Settings</div>
        </div>

        <div class="sidebar-icon" onclick="loadPanel('account')" id="accountIcon">👤
        <div class="sidebar-icon-label">Messages</div>
    </div>
    </div>


    <!-- Sliding Panel -->
    <div id="slidePanel" class="slide-panel"></div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="header">
            <div class="welcome-text">
                Welcome, <span class="welcome-name">@Model.FirstName @Model.LastName</span>
            </div>
            <div style="margin-top: 10px; color: #666;">
                Patient Dashboard - Last updated: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
            </div>
        </div>

        @if (sessions != null && sessions.Count > 0)
        {
            <div class="date-selector">
                <label>View data from:</label>
         <select id="dateSelector" onchange="loadDate(this.value)">
    @foreach (var session in sessions)
    {
        var isSelected = session.Id == currentSession.Id;
        <option value="@session.RecordedDate.ToString("yyyy-MM-dd")" selected="@isSelected">
            @session.RecordedDate.ToString("MMMM dd, yyyy")
        </option>
    }
</select>
            </div>
        }

        
        <!-- <div class="dashboard-grid">
            Heatmap (Left side - spans 2 rows) 
            <div class="card heatmap-container">
                <div class="heatmap-placeholder">
                    <h3>🔥 Pressure Heat Map</h3>
                    <p>32x32 pressure visualization will appear here</p>
                    <p style="margin-top: 10px; font-size: 12px; color: #999;">
                        (CSV data integration - Tomorrow)
                    </p>
                </div>
            </div>
            -->

          <div class="metrics-grid" id="metricsGrid">
            <!-- Peak Pressure -->
            <div class="card">
                 <div class="card-header">
                <div class="card-title">PEAK PRESSURE </div>
                <div class="info-icon">i
                    <div class="tooltip">
                        <strong>Peak Pressure</strong> refers to the highest pressure value recorded in the pressure matrix during the session. It is measured in millimeters of mercury (mmHg) and indicates the maximum force exerted on a specific area.
                    </div>
                </div>
            </div>
                <div class="metric-value" id="peakPressure">@metrics.PeakPressure<span>mmHg</span></div>
            </div>

            <!-- Contact Area -->
            <div class="card">
            <div class="card-header">
                       <div class="card-title">CONTACT AREA</div>
            <div class="info-icon">i
                    <div class="tooltip">
                        <strong>Contact Area</strong> represents the percentage of the seating surface that is in contact with the patient. It is calculated by determining the number of sensors registering pressure above a certain threshold and expressing it as a percentage of the total sensor area.    
         </div>
                </div>
            </div>
          
                <div class="metric-value" id="contactArea">@metrics.ContactAreaPercent<span>%</span></div>
            </div>


            <!-- Coefficient of Variation -->
            <div class="card">
                    <div class="card-header">
                <div class="card-title">COEFFICIENT OF VARIATION</div>
                <div class="info-icon">i
                    <div class="tooltip">
                        The <strong>Coefficient of Variation (CV)</strong> is a statistical measure of the relative variability of pressure readings in the matrix. It is calculated as the ratio of the standard deviation to the mean pressure, expressed as a percentage. A higher CV indicates greater variability in pressure distribution.
                    </div>
                </div>
            </div>
                <div class="metric-value" id="coefficientOfVariation">@metrics.CoefficientOfVariation<span>%</span></div>
            </div>

        

            <!-- Risk Score -->
            <div class="card">
                    <div class="card-header">
                <div class="card-title">RISK SCORE</div>
                <div class="info-icon">i
                    <div class="tooltip">
                        The <strong>Risk Score</strong> is a composite metric that assesses the overall risk of pressure ulcers based on various factors derived from the pressure data, including peak pressure, contact area, and coefficient of variation. The score ranges from 0 to 10, with higher scores indicating greater risk.
                    </div>
                </div>
            </div>
                <div class="metric-value" id="riskScore">@metrics.RiskScore<span>/10</div>
            </div>
        </div>
    </div>
       <script src="~/js/patient-dashboard.js"></script>

</body>
</html>