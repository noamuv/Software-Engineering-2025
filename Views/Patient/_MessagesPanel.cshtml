
@model Software_Engineering_2025.Models.AppUser

<div class="panel-header">
    Messages
    <button class="close-btn" onclick="closePanel()">×</button>
</div>


<div class="messages-container">
    <!-- Left sidebar with contacts -->
    <div class="messages-sidebar">
        <div class="messages-search">
            <input type="text" id="messageSearch" placeholder="🔍 Search messages..." class="search-input">
        </div>
        
        <div class="contacts-list">
            <!-- Sensore AI Contact -->
            <div class="contact-item active" data-contact="sensore-ai" onclick="selectContact('sensore-ai')">
                <div class="contact-avatar ai-avatar">🤖</div>
                <div class="contact-info">
                    <div class="contact-name">Sensore AI</div>
                    <div class="contact-preview">Ask me anything...</div>
                </div>
                <div class="contact-time">Now</div>
            </div>
            
            <!-- Dr. Nshmoud Contact -->
            <div class="contact-item" data-contact="dr-nshmoud" onclick="selectContact('dr-nshmoud')">
                <div class="contact-avatar">👨‍⚕️</div>
                <div class="contact-info">
                    <div class="contact-name">Dr. Nshmoud</div>
                    <div class="contact-preview">I think I've just looked over your reports and it all looks good!</div>
                </div>
                <div class="contact-time">10:02</div>
            </div>
        </div>
    </div>
    
    <!-- Right chat area -->
    <div class="messages-chat-area">
        <div class="chat-header">
            <div class="chat-header-info">
                <div class="chat-avatar" id="chatAvatar">🤖</div>
                <div>
                    <div class="chat-name" id="chatName">Sensore AI</div>
                    <div class="chat-status" id="chatStatus">Online</div>
                </div>
            </div>
        </div>
        
        <div class="messages-display" id="messagesDisplay">
            <div class="message-group sensore-ai-messages">
                <div class="message received">
                    <div class="message-avatar">🤖</div>
                    <div class="message-content">
                        <div class="message-text">Hello! I'm Sensore AI, your intelligent pressure monitoring assistant. How can I help you today?</div>
                    </div>
                </div>
            </div>
            
            <div class="message-group dr-nshmoud-messages" style="display: none;">
                <div class="message received">
                    <div class="message-avatar">👨‍⚕️</div>
                    <div class="message-content">
                        <div class="message-text">Hi! I think I've just looked over your reports and it all looks good!</div>
                        <div class="message-time">10:02</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="message-input-area">
            <form id="messageForm" onsubmit="sendMessage(event)">
                <input type="text" id="messageInput" placeholder="Type a message..." class="message-input" autocomplete="off">
                <button type="submit" class="send-button">Send Message</button>
            </form>
        </div>
    </div>
</div>

<style>
    .panel-header {
        background: linear-gradient(135deg, #5D3FD3, #764ba2);
        color: white;
        padding: 25px;
        font-size: 20px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .close-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
    }

    .panel-content {
        padding: 25px;
    }

    .btn-primary {
        width: 100%;
        padding: 12px;
        background: #5D3FD3;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
</style>