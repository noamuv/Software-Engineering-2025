@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Set Your Password</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #f7f7ff;
            margin: 0;
            padding: 20px;
        }
        .reset-container {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 450px;
        }
        h2 {
            color: #5d3fd3;
            text-align: center;
            margin-bottom: 10px;
        }
        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 500;
        }
        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #5d3fd3;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
        }
        button:hover {
            background-color: #4a2fb0;
        }
        .error {
            background-color: #ffe6e6;
            color: #cc0000;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }
        .requirements {
            background-color: #f0f0f0;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 13px;
        }
        .requirements strong {
            display: block;
            margin-bottom: 8px;
            color: #333;
        }
        .requirements ul {
            margin: 0;
            padding-left: 20px;
        }
        .requirements li {
            margin: 5px 0;
            color: #666;
        }
    </style>
</head>
<body>

   <!-- Password Reset Form Container -->
    <div class="reset-container">
        <h2>Set Your Password</h2>
        <p class="subtitle">Create a strong password for your account</p>
        
        <div class="requirements">
            <strong>Password Requirements:</strong>
            <ul>
                <li>At least 8 characters long</li>
                <li>Include uppercase letters (A-Z)</li>
                <li>Include lowercase letters (a-z)</li>
                <li>Include at least one number (0-9)</li>
                <li>Include at least one special character (!@@#$%^&*)</li>
            </ul>
        </div>
        
        <!-- Display error message if exists -->
        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }
        

        <!-- Password Reset Form -->
        <form method="post">
            <input type="hidden" name="userId" value="@ViewBag.UserId" />
            
            <label>New Password</label>
            <input type="password" 
                   name="newPassword" 
                   placeholder="Enter new password" 
                   required 
                   autofocus />
            
            <label>Confirm Password</label>
            <input type="password" 
                   name="confirmPassword" 
                   placeholder="Confirm new password" 
                   required />
            
            <button type="submit">Set Password & Continue</button>
        </form>
    </div>
</body>
</html>