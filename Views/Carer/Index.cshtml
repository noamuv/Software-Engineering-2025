@model IEnumerable<Software_Engineering.Models.Carer_Access>

@{
    ViewData["Title"] = "My Patients";
}
<div class="container">
    <h1>My Patients</h1>
    <p class="subtitle">Manage and monitor your assigned patients</p>
    <div class="patient-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var access in Model)
            {
                    <div class="patient-card">
                    @if (@access.Patient.User.Status == "Active")
                    {
                        <span class="status-badge active">Active</span>
                    }
                    else if ((@access.Patient.User.Status == "Inactive"))
                    {
                        <span class="status-badge inactive">Inactive</span>
                    }
                    <div class="patient-header">
                        @{
                            var initials = $"{access.Patient.User.First_Name[0]}{access.Patient.User.Last_Name[0]}";
                        }
                            <div class="patient-avatar">@initials</div>
                            <div class="patient-info">
                                <div class="patient-name">@access.Patient.User.Title @access.Patient.User.First_Name @access.Patient.User.Last_Name</div>
                                <div class="patient-id">ID: #PAT-@access.Patient_User_ID</div>
                            </div>
                        </div>
                        <div class="patient-details">
                            <div class="detail-row">
                                <span class="detail-label">Email:</span>
                                <span class="detail-value">@access.Patient.User.Email</span>
                            </div>
                        </div>
                        <div class="patient-actions">
                           <a asp-action="Details" asp-route-id="@access.Patient.User_ID" class="btn btn-primary">View Details</a>
                           <a href="mailto:@access.Patient.User.Email" class="btn btn-secondary">Contact</a>
                        </div>
                    </div>
            }
        }
        else
        {
            <div class="alert-info">
                <strong>ℹ️ No patients assigned</strong>
                <p>You don't have access to any patients at this time.</p>
            </div>
        }
    </div>
</div>

<style>
    .subtitle {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 30px;
    }

    .container {
        /*Center div*/
        max-width: 1200px;
        margin: 0 auto;
    }

    .patient-grid {
        display: grid;
        gap: 20px;
    }

    .patient-card {
        background: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        position: relative;
        overflow: hidden;
    }

    .patient-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .patient-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
    }

    .patient-header {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .patient-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        font-weight: 600;
        margin-right: 16px;
        /*?*/
        flex-shrink: 0;
    }

    .patient-info {
        flex: 1;
    }

    .patient-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 4px;
    }

    .patient-id {
        font-size: 0.85rem;
        color: #6c757d;
        font-family: 'Courier New', monospace;
    }

    .patient-details {
        margin-bottom: 20px;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-size: 0.875rem;
        color: #6c757d;
        width: 80px;
        font-weight: 500;
    }

    .detail-value {
        font-size: 0.95rem;
        color: #2c3e50;
        flex: 1;
    }

    .patient-actions {
        display: flex;
        gap: 10px;
    }

    .btn {
        flex: 1;
        padding: 12px 20px;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126 ,234, 0.4);
    }

    .btn-secondary {
        background: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    .btn-secondary:hover {
        background: #e9ecef;
        color: #495057;
            border: 1px solid #dee2e6;
    }

    .status-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .active {
        background: #d4edda;
        color: #155724;
    }

    .inactive {
        background: #f8d7da;
        color: #721c24;
    }
   
    .alert-info {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 20px;        
        background-color: #e7f3fe;
        border-left: 6px solid #2196F3;
        padding: 10px;
        margin-top: 20px;
    }
</style>