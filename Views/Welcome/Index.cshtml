
@{
    ViewData["Title"] = "Welcome to Sensore";
}

<!-- No layout for this welcome page -->

@{
    Layout = null;
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background-color: #f7f7ff;
    }

    h1 {
        color: #5d3fd3;
        margin-bottom: 40px;
        text-align: center; 
    }

    .user-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .user-card {
        text-align: center;
        background-color: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 20px;
        width: 140px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0px 0px 10px rgba(0,0,0,0.05);
        text-decoration: none;
        color: #333;
    }

    .user-card:hover {
        background-color: #f0edff;
        transform: translateY(-3px);
    }

    .user-card img {
        width: 60px;
        height: 60px;
        margin-bottom: 10px;
        border-radius: 50%;
    }
</style>



<h1>Welcome to Sensore</h1>
<p>Please select your user type to sign in:</p>

<div class="user-grid">
<!-- Each user type card as a form to submit the role -->
<!-- a tag is used to navigate to Auth controller with role parameter -->

    <a asp-controller = "Auth" asp-action="SignIn" asp-route-role= "Patient" class="user-card">
            <img src="/images/patient.png" alt="Patient" />
            <div>Patient</div>
    </a>
    <a asp-controller= "Auth" asp-action="SignIn" asp-route-role = "Clinician" class ="user-card">
            <img src="/images/clinician.png" alt="Clinician" />
            <div>Clinician</div>  
    </a>
    <a asp-controller = "Auth" asp-action="SignIn" asp-route-role ="Carer" class="user-card">
            <img src="/images/carer.png" alt="Carer" />
            <div>Carer</div>
    </a>
    <a  asp-controller="Auth" asp-action="SignIn" asp-route-role="Admin" class="user-card">
            <img src="/images/admin.png" alt="Admin" />
            <div>Admin</div>
    </a>
    
</div>